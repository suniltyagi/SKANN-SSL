# =========================
# SKANN-SSL repo .gitignore
# =========================
# Intent (custom):
# - COMMIT: Stage-6 vessel_territories_stage6_*.joblib
# - COMMIT: Stage-6 confusion_matrix.png + confusion_report.txt
# - COMMIT: Stage-3 runs/*/loss_history.csv (posterity)
# - COMMIT: notebooks (.ipynb)
# - COMMIT: UMAP diagnostic under artifacts/diagnostics
# - COMMIT: data/prototype_dataset/pairing_manifest.csv
#
# - IGNORE: heavy weights (*.pth/*.pt/*.ckpt), generic joblibs, and most generated artifacts/runs.

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
ENV/
env/

# Jupyter runtime
.ipynb_checkpoints/

# ---- Large model/weight formats (ignore) ----
*.pth
*.pt
*.ckpt
*.onnx
*.h5
*.tflite
*.npy

# ---- Generic joblib (ignore) ----
*.joblib

# ---- Stage generated outputs (ignore by default) ----
stages/**/runs/**
stages/**/artifacts/**

# =============================================================================
# Exceptions (ALLOW-LIST) — place AFTER ignore rules
# =============================================================================

# Keep project-facing diagnostics
!stages/**/artifacts/diagnostics/
!stages/**/artifacts/diagnostics/**

# Keep specific Stage-6 artifacts
!stages/stage6_evaluation/artifacts/vessel_territories_stage6_*.joblib
!stages/stage6_evaluation/artifacts/confusion_matrix.png
!stages/stage6_evaluation/artifacts/confusion_report.txt

# Keep loss history for posterity (even though runs/ is ignored)
!stages/stage3_ssl/runs/
!stages/stage3_ssl/runs/**/
!stages/stage3_ssl/runs/**/loss_history.csv
!stages/stage3_ssl/runs/**/loss_history.txt
!stages/stage3_ssl/runs/README.md
!stages/stage3_ssl/runs/**/run_metadata.yaml

# Keep baseline pairing manifest in data/
!data/prototype_dataset/pairing_manifest.csv

# ---- Binaries (don’t try to diff) ----
*.png
*.jpg
*.jpeg
*.pdf

# Local backups
data/prototype_dataset/*BACKUP*.csv
stages/stage3_ssl/*backup*.py

# Local scratch files (do not commit)
structure.txt
structure_clean.txt
generate_metadata_post_hoc.py

# Large artefacts (use Google Drive)
stages/stage3_ssl/artifacts/*.joblib

# Stage-3 trained model artefacts (kept locally, not versioned)
stages/stage3_ssl/artifacts/*.joblib

# =============================================================================
# Stage 7 Demo - Large Data Files (local only, not versioned)
# =============================================================================

# Demo model bundles (user downloads or copies from training)
stages/stage7_deployment/demo/model/*.joblib

# Demo tensor data (user copies or symlinks to data/prototype_dataset/tensors/)
stages/stage7_deployment/demo/data/tensors/*.npy

# Allow .gitkeep placeholders so directories exist after clone
!stages/stage7_deployment/demo/model/.gitkeep
!stages/stage7_deployment/demo/data/tensors/.gitkeep

# Allow the manifest (small metadata file ~542KB)
!stages/stage7_deployment/demo/data/manifest.csv

 
# ============================================================================= 
# Stage 3 Artifacts - Allow small files, ignore large ones 
# ============================================================================= 
!stages/stage3_ssl/artifacts/vessel_territories_v3.joblib 
!stages/stage3_ssl/artifacts/labels.npy 
!stages/stage3_ssl/artifacts/loss_history.csv 
!stages/stage3_ssl/artifacts/final_metrics.txt 
